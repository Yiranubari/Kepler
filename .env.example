NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kepler

GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACE_API_KEY=<your-huggingface-api-key>
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
AI_TIMEOUT_MS=20000
AI_CACHE_TTL_SECONDS=900
AI_MAX_INPUT_CHARS=12000

NWC_CONNECTION_STRING=nostr+walletconnect://<pubkey>?relay=<relay>&secret=<secret>
NWC_TIMEOUT_MS=5000

NOSTR_PRIVATE_KEY=<your-64-hex-private-key>
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

BITCOIN_NETWORK=testnet4
ESPLORA_URL=https://mempool.space/api
ESPLORA_FALLBACK_URL=https://blockstream.info/api

CASHU_MINT_URL=https://mint.minibits.cash/Bitcoin
CASHU_MINT_URL_FALLBACK=https://testnut.cashu.space
CASHU_TEST_TOKEN=
CASHU_UNIT=sat
CASHU_REQUEST_TIMEOUT_MS=15000

RATE_LIMIT_READ_PER_MINUTE=60
RATE_LIMIT_PROPOSE_PER_MINUTE=30
RATE_LIMIT_SEND_PER_HOUR=20
RATE_LIMIT_PUBLISH_PER_HOUR=100

LOG_LEVEL=info
LOG_DIR=logs

TAINT_TEMPORAL_WINDOW_SECONDS=3600
TAINT_MIN_EDGE_CONFIDENCE=0.3
TAINT_MAX_PATH_DEPTH=5
TAINT_CO_OCCURRENCE_THRESHOLD=3
TAINT_MAX_NODES_PER_GRAPH=10000
TAINT_MAX_EDGES_PER_GRAPH=50000
