# Environment Configuration for Kepler
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kepler

# AI Providers
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Lightning Network (NWC Connection String)
NWC_CONNECTION_STRING=nostr+walletconnect://...

# Bitcoin / Esplora
ESPLORA_URL=https://mempool.space/api
ESPLORA_FALLBACK_URL=https://blockstream.info/api

# Nostr Relays (comma-separated)
RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# Cashu Mints
CASHU_MINT=https://mint.minibits.cash/Bitcoin
CASHU_MINT_FALLBACK=https://testnut.cashu.space
