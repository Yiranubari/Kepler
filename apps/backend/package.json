{
  "name": "@kepler/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "openapi:lint": "npx @redocly/cli lint openapi.yaml"
  },
  "dependencies": {
    "@kepler/shared": "*",
    "@kepler/bitcoin": "*",
    "@kepler/lightning": "*",
    "@kepler/nostr": "*",
    "@kepler/cashu": "*",
    "@prisma/client": "^5.0.0",
    "express": "^4.18.2",
    "dotenv": "^16.4.5",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "prisma": "^5.0.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@kepler/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": true,
            "esModuleInterop": true,
            "module": "commonjs",
            "target": "ES2022"
          }
        }
      ]
    }
  }
}
