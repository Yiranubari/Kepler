# core
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kepler
CORS_ORIGIN=http://localhost:5173

# rate limits
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_PROPOSE_PER_MINUTE=60
RATE_LIMIT_SEND_PER_HOUR=20
RATE_LIMIT_PUBLISH_PER_HOUR=100

# taint
TAINT_TEMPORAL_WINDOW_SECONDS=3600
TAINT_MIN_EDGE_CONFIDENCE=0.3
TAINT_MAX_PATH_DEPTH=5
TAINT_CO_OCCURRENCE_THRESHOLD=3
TAINT_MAX_NODES_PER_GRAPH=10000
TAINT_MAX_EDGES_PER_GRAPH=50000

# bitcoin
BITCOIN_NETWORK=testnet4
ESPLORA_URL=https://mempool.space/testnet4/api
ESPLORA_FALLBACK_URL=https://mempool.space/testnet4/api

# lightning
NWC_CONNECTION_STRING=nostr+walletconnect://replace-with-your-connection-string
NWC_TIMEOUT_MS=15000

# nostr
RELAYS=wss://nos.lol,wss://relay.primal.net
NOSTR_PRIVATE_KEY=replace-with-a-64-character-hex-private-key
NOSTR_RELAYS=wss://nos.lol,wss://relay.primal.net
NOSTR_TIMEOUT_MS=15000
NOSTR_PUBLISH_TIMEOUT_MS=5000
NOSTR_SUBSCRIPTION_LIMIT=500

# cashu
CASHU_MINT_URL=https://testnut.cashu.space
CASHU_UNIT=sat
CASHU_REQUEST_TIMEOUT_MS=15000

# ai
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACE_API_KEY=replace-with-your-hugging-face-api-key
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
AI_TIMEOUT_MS=20000
AI_CACHE_TTL_SECONDS=900
AI_MAX_INPUT_CHARS=12000

# logging
LOG_LEVEL=info
LOG_DIR=logs
